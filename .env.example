# Pixotchi Mini - Example Environment Variables
# Copy this file to `.env.local` and fill in values.
#
# Minimal for local dev:
# - NEXT_PUBLIC_URL
# - RPCs (at least NEXT_PUBLIC_RPC_NODE)
# - Redis (choose one provider block) + ADMIN_TOKEN
# - Optional: AI provider keys, dedicated AI RPC, Privy App ID

############################
# App URLs (Public)
############################
NEXT_PUBLIC_URL=http://localhost:3000
# Legacy public Graph API override. Leave unset once Activity runs through same-origin app routes.
NEXT_PUBLIC_PONDER_API_URL=

############################
# Base RPCs (Public)
############################
# HTTP endpoints (set multiple for failover)
NEXT_PUBLIC_RPC_NODE=
NEXT_PUBLIC_RPC_NODE_FALLBACK=
NEXT_PUBLIC_RPC_NODE_BACKUP_1=
NEXT_PUBLIC_RPC_NODE_BACKUP_2=
NEXT_PUBLIC_RPC_NODE_BACKUP_3=
# Optional WSS endpoints
NEXT_PUBLIC_RPC_NODE_WSS=
NEXT_PUBLIC_RPC_NODE_FALLBACK_WSS=

############################
# Contracts (Public)
############################
# Base mainnet addresses (leave empty to use app defaults or set your own)
NEXT_PUBLIC_LAND_CONTRACT_ADDRESS_MAINNET=
NEXT_PUBLIC_LEAF_TOKEN_ADDRESS_MAINNET=
NEXT_PUBLIC_STAKE_CONTRACT_ADDRESS=

############################
# Feature Flags (Public)
############################
NEXT_PUBLIC_PAYMASTER_ENABLED=false
# Temporary kill switch for missions/tasks/rocks leaderboard on player side
NEXT_PUBLIC_GAMIFICATION_DISABLED=false
# Deprecated: mini-app-only feature gating is ignored after the Base App web cutover
NEXT_PUBLIC_GAMIFICATION_MINIAPP_ONLY=false
NEXT_PUBLIC_GAMIFICATION_DISABLED_MESSAGE=Tasks and Rocks leaderboard are temporarily disabled while we reset progress for the next mission season.
NEXT_PUBLIC_CASINO_ENABLED=true
# Deprecated: mini-app-only feature gating is ignored after the Base App web cutover
NEXT_PUBLIC_CASINO_MINIAPP_ONLY=false
NEXT_PUBLIC_BLACKJACK_ENABLED=true
NEXT_PUBLIC_BARRACKS_ENABLED=true
NEXT_PUBLIC_BARRACKS_PREVIEW_ENABLED=false
# Base Verify: free plant claim + optional token bonuses
NEXT_PUBLIC_VERIFY_CLAIM_ENABLED=false
NEXT_PUBLIC_VERIFY_CLAIM_LEAF_BONUS_ENABLED=false
NEXT_PUBLIC_VERIFY_CLAIM_SEED_BONUS_ENABLED=false
# Local/debug only: show internal swap quote route/min-out/slippage summary in the Swap tab.
NEXT_PUBLIC_SWAP_QUOTE_SUMMARY_ENABLED=false
# Agent smart account address (for bonus balance checks in status endpoint)
VERIFY_CLAIM_AGENT_ADDRESS=
# Seasonal: enable subtle snow particles effect
NEXT_PUBLIC_SNOW_ENABLED=false

############################
# UI Assets (Public)
############################
# Optional: absolute URLs
NEXT_PUBLIC_ICON_URL=
NEXT_PUBLIC_APP_HERO_IMAGE=
NEXT_PUBLIC_SPLASH_IMAGE=
NEXT_PUBLIC_SPLASH_BACKGROUND_COLOR=#2d3c53

############################
# CDP / Paymaster (Client, optional)
############################
NEXT_PUBLIC_CDP_CLIENT_API_KEY=
NEXT_PUBLIC_CDP_PAYMASTER_URL=
NEXT_PUBLIC_ONCHAINKIT_PROJECT_NAME=Pixotchi Mini

############################
# Notifications
############################
# Keep these two values in sync so client and server switch together.
# Supported values: neynar | base
NEXT_PUBLIC_NOTIFICATION_PROVIDER=base
NOTIFICATION_PROVIDER=base
# Neynar provider (legacy/optional)
NEYNAR_API_KEY=
NEYNAR_APP_ID=
# Base App provider (server-only)
BASE_NOTIFICATIONS_API_KEY=
# Optional: set these to match your deployed Vercel function duration.
BASE_AUDIENCE_SYNC_MAX_DURATION_SECONDS=300
BASE_AUDIENCE_SYNC_EXECUTION_BUDGET_MS=

############################
# Auth (Public, optional)
############################
NEXT_PUBLIC_PRIVY_APP_ID=
# Privy server auth (server-only)
PRIVY_APP_SECRET=
# Recommended: copy the JWT verification key from the Privy dashboard to avoid runtime JWKS fetches.
PRIVY_JWT_VERIFICATION_KEY=

############################
# Redis / KV (Server-only) - choose ONE block
############################
# Upstash Redis REST
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# or Vercel KV
KV_REST_API_URL=
KV_REST_API_TOKEN=

# or KV (compat alt)
KV_KV_REST_API_URL=
KV_KV_REST_API_TOKEN=

# or Redis URL + Token
REDIS_URL=
REDIS_TOKEN=

############################
# Admin & CORS (Server-only)
############################
ADMIN_TOKEN=replace-with-strong-secret
# HMAC secret used to sign /api/swap/quote tokens so /api/swap/build-step can
# trust them without a round-trip to storage. Must be >=32 chars in production.
SWAP_QUOTE_SIGNING_SECRET=replace-with-strong-random-64-char-secret
# Keep bridge debug routes private in production by default.
# Set to true only if you intentionally want public production access.
BRIDGE_DEBUG_PUBLIC_ENABLED=false
ALLOWED_ADMIN_ORIGINS=http://localhost:3000,https://mini.pixotchi.tech
ALLOWED_PUBLIC_API_ORIGINS=
# Optional frame embedding allowlist for the main app CSP.
# Defaults already include the Pixotchi domains plus Farcaster/Warpcast and localhost.
ALLOWED_FRAME_ANCESTORS=
# Optional server-side override for gamification kill switch
GAMIFICATION_DISABLED=false
# Deprecated: mini-app-only feature gating is ignored after the Base App web cutover
GAMIFICATION_MINIAPP_ONLY=false
CASINO_ENABLED=true
# Deprecated: mini-app-only feature gating is ignored after the Base App web cutover
CASINO_MINIAPP_ONLY=false
BLACKJACK_ENABLED=true
INDEXER_UPSTREAM_URL=
INDEXER_SHARED_SECRET=
STATUS_SNAPSHOT_TTL_SECONDS=300
# Dedicated health endpoint for ecosystem app checks. Prefer /api/health so firewall bypass can stay narrow.
STATUS_APP_HEALTH_URL=https://mini.pixotchi.tech/api/health

############################
# AI Provider (Server-only)
############################
# Choose: gateway | openai | anthropic | claude | google
AI_PROVIDER=gateway
# Optional model override. Gateway model strings use <provider>/<model>, for example openai/gpt-5-mini.
AI_MODEL=openai/gpt-5-mini
# Optional comma-separated Gateway fallback model chain.
AI_FALLBACK_MODELS=anthropic/claude-sonnet-4.5,google/gemini-3.5-flash
# Optional: max tokens per final answer. Production default is 4096.
AI_MAX_TOKENS=4096
AI_MAX_TOKENS_PER_DAY=1000000
AI_AUTO_CONTINUE_ON_LENGTH=true
AI_PLANNING_MAX_OUTPUT_TOKENS=1024
AI_CONTINUATION_MAX_OUTPUT_TOKENS=2048
AI_GOOGLE_THINKING_LEVEL=high
AI_GOOGLE_THINKING_BUDGET=0
# Optional: max JSON request body accepted by /api/chat/ai/send before parsing.
AI_CHAT_MAX_REQUEST_BYTES=8192
# Optional: keep live wallet-history queries usable for large wallets inside the 60s route budget.
AI_REQUEST_TIMEOUT_MS=45000
AI_STEP_TIMEOUT_MS=25000
# Optional: AI wallet activity fallback limits. RPC fallback only checks known Pixotchi contracts.
AI_WALLET_ACTIVITY_BLOCK_RANGE=150000
AI_WALLET_ACTIVITY_LOG_LIMIT=60
AI_WALLET_ACTIVITY_LOG_CHUNK_CONCURRENCY=4
# Optional: comma-separated additional custody/team/internal wallets that Neural Seed must never expose.
AI_CUSTODY_WALLET_ADDRESSES=
# Optional: max time window the AI can query for indexed combat history, in hours.
AI_COMBAT_ACTIVITY_MAX_HOURS=744
# Optional: dedicated AI read RPC. If unset, the AI agent uses the public Base fallback below.
AI_BASE_RPC_URL=
AI_BASE_RPC_PUBLIC_FALLBACK_URL=https://mainnet.base.org

# Keys (set according to AI_PROVIDER)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
AI_GATEWAY_API_KEY=
VERCEL_OIDC_TOKEN=

############################
# Webhooks & Farcaster (Server-only)
############################
WEBHOOK_SECRET=
FARCASTER_HEADER=
FARCASTER_PAYLOAD=
FARCASTER_SIGNATURE=

############################
# Optional Network Hint (Server-only)
############################
# Defaults to "base" when unset
NETWORK_ID=base
