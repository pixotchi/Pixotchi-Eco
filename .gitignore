# Local one-off scripts stay ignored, but package runners and repeatable project
# tooling must be tracked so a fresh clone can reproduce checks and artifacts.
# Note: `scripts/*` (contents) rather than `scripts/` (the directory), because git
# cannot re-include a path whose parent directory is excluded.
scripts/*
!scripts/capture-tutorial.mts
!scripts/render-tutorial-art.mjs
!scripts/check-base-rpc-hardening.mjs
!scripts/check-frontend-release.mjs
!scripts/check-frontend-p1.mjs
!scripts/check-frontend-p2.mjs
!scripts/check-frontend-p3.mjs
!scripts/check-frontend-type-boundaries.mjs
!scripts/frontend-type-boundaries.json
!scripts/test-casino-p1.mjs
!scripts/test-arcade-p1.mjs
!scripts/run-eslint-chunked.mjs
!scripts/run-react-server-smoke.mjs
!scripts/check-contract-deployments.ts
!scripts/reconcile-blackjack-aliases.ts
!scripts/reconcile-airdrop.ts
!scripts/lib/
scripts/lib/*
!scripts/lib/deployment-inventory.ts
!scripts/art/
!scripts/art/*.mjs
exports/
pixotchi-onchain/
tools/
v22/
output/
test-results/
